# All optional: defaults point at the live Monad testnet deployment (deployments/monad-testnet.json).
NEXT_PUBLIC_CONTRACT_ADDRESS=0x860844ca0ca1f3ec43a8045370d7cef8b329f141
NEXT_PUBLIC_ORACLE_ADDRESS=0x762378bcabb0507b56c56fcdd24986b3f6d5c1b3
